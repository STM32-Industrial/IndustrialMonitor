  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #0f141a;
}

/* ---------- 顶部标题栏 ---------- */
QLabel#titleLabel {
    color: #e6edf3;
    font-size: 22px;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #5c6773;
    font-size: 12px;
}
QLabel#connDot {
    background-color: #5c6773;
    border-radius: 6px;
}
QLabel#connStateLabel {
    color: #8b949e;
    font-size: 13px;
}
QLabel#brokerLabel {
    color: #8b949e;
    font-size: 13px;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}

/* ---------- 卡片 ---------- */
QFrame#tempCard, QFrame#humiCard, QFrame#smokeCard, QFrame#statusCard,
QFrame#rpmCard, QFrame#pressCard, QFrame#vibCard {
    background-color: #141b26;
    border: 1px solid #232d3d;
    border-radius: 12px;
}
QFrame#tempCard   { border-left: 3px solid #4fc3f7; }
QFrame#humiCard   { border-left: 3px solid #34d399; }
QFrame#smokeCard  { border-left: 3px solid #fbbf24; }
QFrame#statusCard { border-left: 3px solid #a78bfa; }
QFrame#rpmCard    { border-left: 3px solid #22d3ee; }
QFrame#pressCard  { border-left: 3px solid #c084fc; }
QFrame#vibCard    { border-left: 3px solid #f472b6; }

QLabel#tempTitle, QLabel#humiTitle, QLabel#smokeTitle, QLabel#statusTitle,
QLabel#rpmTitle, QLabel#pressTitle, QLabel#vibTitle {
    color: #8b949e;
    font-size: 13px;
}
QLabel#tempValue {
    color: #4fc3f7;
    font-size: 46px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#humiValue {
    color: #34d399;
    font-size: 46px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#smokeValue {
    color: #fbbf24;
    font-size: 46px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#tempUnit, QLabel#humiUnit {
    color: #5c6773;
    font-size: 18px;
    padding-top: 18px;
}

QLabel#rpmValue {
    color: #22d3ee;
    font-size: 36px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#pressValue {
    color: #c084fc;
    font-size: 36px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#vibValue {
    color: #f472b6;
    font-size: 36px;
    font-weight: 700;
    font-family: 'Consolas', 'Droid Sans Mono', monospace;
}
QLabel#rpmUnit, QLabel#pressUnit, QLabel#vibUnit {
    color: #5c6773;
    font-size: 15px;
    padding-top: 14px;
}
QLabel#statusValue {
    color: #34d399;
    background-color: #12291f;
    border: 1px solid #1f4d38;
    border-radius: 8px;
    font-size: 20px;
    font-weight: 700;
    padding: 8px 26px;
}

/* ---------- 阀门控制按钮 ---------- */
QPushButton#valveBtnOpen, QPushButton#valveBtnClose {
    color: #e6edf3;
    background-color: #1c2735;
    border: 1px solid #33415c;
    border-radius: 8px;
    padding: 11px 26px;
    font-size: 15px;
    font-weight: 700;
}
QPushButton#valveBtnOpen:hover {
    color: #34d399;
    background-color: #12291f;
    border: 1px solid #1f4d38;
}
QPushButton#valveBtnOpen:pressed {
    background-color: #0d2017;
}
QPushButton#valveBtnClose:hover {
    color: #f87171;
    background-color: #2b1318;
    border: 1px solid #6b1f2b;
}
QPushButton#valveBtnClose:pressed {
    background-color: #220d12;
}

/* ---------- 标签页 ---------- */
QTabWidget#tabWidget::pane {
    border: none;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8b949e;
    padding: 10px 28px;
    font-size: 14px;
    border-top: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #4fc3f7;
    border-top: 2px solid #4fc3f7;
    background-color: #141b26;
}
QTabBar::tab:hover:!selected {
    color: #c9d1d9;
}

/* ---------- 图表容器 ---------- */
QFrame#tempHumiChartContainer, QFrame#smokeChartContainer, QFrame#statusChartContainer {
    background-color: #141b26;
    border: 1px solid #232d3d;
    border-radius: 12px;
}
QLabel#chartNoteLabel {
    color: #5c6773;
    font-size: 12px;
}

QStatusBar {
    background-color: #0c1116;
    color: #5c6773;
}</string>
